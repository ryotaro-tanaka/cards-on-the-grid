{
  "name": "boardgame",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "clean": "rm -rf packages/*/dist",
    "build:frontend:pages": "npm run typecheck && vite build --config packages/frontend/vite.config.mjs",
    "deploy:backend": "npx wrangler --cwd packages/backend deploy",
    "deploy:backend:version": "npx wrangler --cwd packages/backend versions upload",
    "deploy:frontend": "npm run build:frontend:pages && npx wrangler --cwd packages/frontend pages deploy dist",
    "deploy": "npm run deploy:backend && npm run deploy:frontend",
    "e2e:smoke": "npm run typecheck && node --experimental-specifier-resolution=node scripts/e2e-smoke.mjs",
    "test:core": "npm run typecheck && node --experimental-specifier-resolution=node scripts/core-unit.mjs",
    "test:frontend": "npm run typecheck && node --experimental-specifier-resolution=node scripts/frontend-unit.mjs"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.4.14"
  }
}
